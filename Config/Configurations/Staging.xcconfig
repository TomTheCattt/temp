#include "Base.xcconfig"
#include? "Secrets.xcconfig"

// Environment & Display Name
APP_ENVIRONMENT = staging
APP_NAME = Instagram (Staging)

// Backend Type Selection: "firebase" or "live" (Custom REST API)
// Decoupled: easily switchable when backend is finalized without touching Swift code.
BACKEND_TYPE = firebase
APP_BASE_URL = https:$(SLASH)/staging-api.example.com

// Logging & Debugging (Enabled for QA testing on TestFlight)
ENABLE_DEBUG_LOGGING = YES

// Compiler Conditions & Optimizations (Production-grade optimization with dSYM and STAGING flag)
SWIFT_ACTIVE_COMPILATION_CONDITIONS = STAGING $(inherited)
GCC_PREPROCESSOR_DEFINITIONS = STAGING=1 $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -O
GCC_OPTIMIZATION_LEVEL = s
VALIDATE_PRODUCT = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
